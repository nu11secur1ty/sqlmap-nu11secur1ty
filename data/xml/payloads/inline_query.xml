    <test>
        <title>Generic inline queries with SUBSTRING</title>
        <stype>3</stype>
        <level>3</level>
        <risk>1</risk>
        <clause>1,2,3,8</clause>
        <where>3</where>
        <vector>(SELECT SUBSTRING(([QUERY]),1,1024))</vector>
        <request>
            <payload>(SELECT SUBSTRING((CASE WHEN ([RANDNUM]=[RANDNUM]) THEN '1' ELSE '0' END),1,1024))</payload>
        </request>
        <response>
            <comparison>Compare numeric/string responses for boolean inference</comparison>
        </response>
    </test>

    <test>
