        <where>3</where>
        <vector>([QUERY])</vector>
        <request>
            <payload>([RANDNUM]=[RANDNUM])</payload>
        </request>
        <response>
            <comparison>Compare numeric responses (1 for true, 0 for false)</comparison>
        </response>
    </test>

